<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= page.title ? afterlight_plain(page.title) + ' · ' : '' %><%= theme.brand.name %></title>
  <meta name="description" content="<%= (page.content && afterlight_summary(page, 150)) || (page.title ? afterlight_plain(page.title) + ' · ' : '') + theme.brand.subtitle %>">
  <link rel="icon" href="<%= url_for('/afterlight/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url_for('/afterlight/theme.css') %>">
  <link rel="stylesheet" href="<%= url_for('/afterlight/components.css') %>">
  <link rel="stylesheet" href="<%= url_for('/afterlight/refinements.css') %>">
  <script src="<%= url_for('/afterlight/appearance.js') %>"></script>
  <% if (page.content && (page.plugins?.mathjax || page.engine === 'statement' || page.tikzjax)) { %>
  <link rel="stylesheet" href="<%= url_for('/afterlight/math.css') %>">
  <script>window.MathJax={tex:{inlineMath:[['$','$'],['\\(','\\)']]},chtml:{matchFontHeight:false},startup:{typeset:false}};</script>
  <% } %>
</head>
<body class="afterlight <%= is_home() ? 'view-home' : 'view-inner' %>">
  <a class="skip-link" href="#main">跳到正文</a>
  <%- partial('partial/header') %>
  <main id="main"><%- body %></main>
  <%- partial('partial/footer') %>
  <% if (theme.search.enable) { %><%- partial('partial/search') %><% } %>
  <script defer src="<%= url_for('/afterlight/dialogs.js') %>"></script>
  <script defer src="<%= url_for('/afterlight/theme.js') %>"></script>
  <% if (theme.search.enable) { %><script defer src="<%= url_for('/afterlight/search.js') %>"></script><% } %>
  <% if (page.content) { %>
  <script defer src="<%= url_for('/afterlight/reading.js') %>"></script>
  <% if (theme.gallery.enable) { %><script defer src="<%= url_for('/afterlight/gallery.js') %>"></script><% } %>
  <% if (theme.comments.enable) { %><script defer src="<%= url_for('/afterlight/comments.js') %>"></script><% } %>
  <% if (page.plugins?.mathjax || page.engine === 'statement' || page.tikzjax) { %><script defer src="<%= url_for('/afterlight/math.js') %>" data-math-src="<%= theme.math.src %>"></script><% } %>
  <% } %>
</body>
</html>
