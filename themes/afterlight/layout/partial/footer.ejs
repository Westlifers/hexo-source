<footer class="site-footer shell">
  <a class="footer-name" href="<%= url_for('/') %>"><%= theme.brand.name %></a>
  <div class="footer-links"><% if (theme.footer.link?.label && theme.footer.link?.url) { %><a href="<%= url_for(theme.footer.link.url) %>"><%= theme.footer.link.label %> ↗</a><% } %><span>© <%= new Date().getFullYear() %> <%= theme.brand.author %><% if (theme.footer.credit) { %> · <%= theme.footer.credit %><% } %></span></div>
</footer>
