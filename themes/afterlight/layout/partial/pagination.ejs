<% if (page.total > 1) { %>
<nav class="pagination" aria-label="文章分页">
  <% if (page.prev) { %><a href="<%= url_for(page.prev_link) %>">← 上一页</a><% } else { %><span></span><% } %>
  <span class="mono"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %><a href="<%= url_for(page.next_link) %>">下一页 →</a><% } else { %><span></span><% } %>
</nav>
<% } %>
