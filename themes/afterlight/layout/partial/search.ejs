<dialog id="search-dialog" class="afterlight-dialog search-dialog" aria-labelledby="search-heading" data-index="<%= url_for('/afterlight/search.json') %>">
  <div class="dialog-heading"><h2 id="search-heading">搜索</h2><button type="button" data-dialog-close aria-label="关闭搜索">×</button></div>
  <label class="sr-only" for="search-input">标题、标签或正文关键词</label>
  <input id="search-input" type="search" placeholder="搜索标题、标签或正文" autocomplete="off" autofocus>
  <p data-search-status role="status">输入关键词，找一篇文字。</p>
  <button type="button" data-search-retry hidden>重新加载</button>
  <ol class="search-results" aria-label="搜索结果"></ol>
</dialog>
