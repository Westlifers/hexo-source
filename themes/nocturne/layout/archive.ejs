<div class="shell collection"><header class="collection-heading"><p class="small-note">时间保存了这些回声</p><h1>所有文字<span class="heading-count"><%= n_stats().posts %></span></h1><p>数学，诗，城市，以及生活本来的样子。</p></header><div class="archive-categories"><a href="<%= url_for('/archives/') %>">全部</a><% site.categories.sort('name').each(category=>{ %><a href="<%= url_for(category.path) %>"><%= category.name %><small><%= category.length %></small></a><% }); %></div><%- partial('partial/post-list', { entries: page.posts }) %><%- partial('partial/pagination') %></div>
