<%
const archivePosts = site.posts.toArray().filter(entry => entry.published !== false && !entry.source?.startsWith('_drafts/')).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const archiveKinds = [{ key: 'mathematics', label: '数学', description: '结构、证明与未完的问题' }, { key: 'essays', label: '随笔', description: '思考如何走进日常' }, { key: 'poetry', label: '诗与声音', description: '写下的，也唱出来' }, { key: 'fieldnotes', label: '人间漫游', description: '城市、游戏与偶然相遇' }];
const archiveYears = [...new Set(archivePosts.map(entry => date(entry.date, 'YYYY')))];
const initialYear = page.year ? String(page.year) : '';
const initialMonth = page.month ? String(page.month).padStart(2, '0') : '';
const matchesInitial = entry => (!initialYear || date(entry.date, 'YYYY') === initialYear) && (!initialMonth || date(entry.date, 'MM') === initialMonth);
const archiveTagCounts = new Map();
archivePosts.forEach(entry => entry.tags?.each(tag => archiveTagCounts.set(tag.name, (archiveTagCounts.get(tag.name) || 0) + 1)));
const archiveThreads = [...archiveTagCounts].filter(([name, count]) => count > 1 && name !== '随笔').sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN')).slice(0, 4);
%>
<div class="shell archive-library" data-archive data-archive-url="<%= url_for('/archives/') %>" data-initial-year="<%= initialYear %>" data-initial-month="<%= initialMonth %>">
  <header class="archive-heading">
    <div><p class="archive-kicker">文字的来处与去处</p><h1>所有文字<span><%= archivePosts.length %> 篇</span></h1><p class="archive-intro">一些证明，一些见闻，也有不必证明的生活。</p></div>
    <div class="archive-span"><span><%= archiveYears.at(-1) || '' %><% if (archiveYears.length > 1) { %> — <%= archiveYears[0] %><% } %></span><a href="<%= url_for('/atlas/') %>">换一张星图看世界 <span aria-hidden="true">↗</span></a></div>
  </header>
  <div class="archive-layout">
    <aside class="archive-sidebar" data-archive-tools hidden aria-label="文章主题">
      <div class="archive-topic-list" role="group" aria-label="按主题筛选">
        <button type="button" class="archive-topic is-active" data-archive-kind="" aria-pressed="true"><span>全部文字</span><small data-kind-count=""><%= archivePosts.length %></small></button>
        <% archiveKinds.forEach(kind => { %>
        <button type="button" class="archive-topic" data-archive-kind="<%= kind.key %>" aria-pressed="false"><span><%= kind.label %><em><%= kind.description %></em></span><small data-kind-count="<%= kind.key %>"><%= archivePosts.filter(entry => n_kind(entry).key === kind.key).length %></small></button>
        <% }); %>
      </div>
      <button type="button" class="archive-saved" data-archive-saved aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h11v17L12 17l-5.5 3.5z"/></svg><span>我的收藏</span><small data-archive-saved-count>0</small></button>
      <p class="archive-local-note">收藏保存在当前浏览器。</p>
      <% if (archiveThreads.length) { %><div class="archive-threads"><h2>沿着线索读</h2><% archiveThreads.forEach(([name, count]) => { %><button type="button" data-archive-tag="<%= name %>" aria-pressed="false"><span><%= name %></span><small><%= count %></small></button><% }); %></div><% } %>
    </aside>
    <div class="archive-main">
      <form class="archive-controls" data-archive-controls hidden role="search" aria-label="筛选文章">
        <label class="archive-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only" id="archive-query-label">搜索标题、摘要或标签</span><input type="search" name="q" data-archive-query aria-labelledby="archive-query-label" placeholder="找一个问题，一段记忆…" autocomplete="off" maxlength="200"><button type="button" class="archive-clear-query" data-archive-clear-query hidden aria-label="清除搜索">×</button></label>
        <div class="archive-selects"><div class="archive-select" data-archive-select><label class="sr-only" id="archive-year-label" for="archive-year">按年份筛选</label><select id="archive-year" name="year" data-archive-year><option value="">所有年份</option><% archiveYears.forEach(year => { %><option value="<%= year %>"><%= year %> 年</option><% }); %></select></div><div class="archive-select" data-archive-select><label class="sr-only" id="archive-sort-label" for="archive-sort">文章排序</label><select id="archive-sort" name="sort" data-archive-sort><option value="newest">最近写下的</option><option value="oldest">从最早读起</option><option value="shortest">先读短篇</option></select></div></div>
      </form>
      <div class="archive-toolbar"><p data-archive-status role="status" aria-live="polite" aria-atomic="true"><%= archivePosts.filter(matchesInitial).length %> 篇文字<% if (initialYear) { %>，写于 <%= initialYear %> 年<% if (initialMonth) { %> <%= Number(initialMonth) %> 月<% } %><% } %></p><div data-archive-actions hidden><button type="button" data-archive-reset hidden>清除筛选</button><button type="button" data-archive-share>复制筛选链接</button></div></div>
      <p class="archive-active-filter" data-archive-active hidden></p>
      <noscript><nav class="archive-static-links" aria-label="按分类浏览"><a href="<%= url_for('/archives/') %>">全部文字</a><% site.categories.sort('name').each(category => { %><a href="<%= url_for(category.path) %>"><%= category.name %></a><% }); %></nav></noscript>
      <div class="archive-results" data-archive-results>
        <% archiveYears.forEach(year => { const group = archivePosts.filter(entry => date(entry.date, 'YYYY') === year); %>
        <section class="archive-year-group" aria-label="<%= year %> 年的文章" <%- initialYear && year !== initialYear ? 'hidden' : '' %>><h2 class="archive-year-heading"><span><%= year %></span><small><%= group.filter(matchesInitial).length %> 篇</small></h2><div class="archive-entries">
          <% group.forEach(entry => { const kind = n_kind(entry); const tags = entry.tags?.toArray().map(tag => tag.name) || []; const summary = n_summary(entry, 110); %>
          <article class="archive-entry" data-archive-entry data-title="<%= n_plain(entry.title) %>" data-summary="<%= summary %>" data-kind="<%= kind.key %>" data-kind-label="<%= kind.label %>" data-date="<%= date(entry.date, 'YYYY-MM-DD') %>" data-time="<%= entry.date.valueOf() %>" data-minutes="<%= n_minutes(entry) %>" data-tags="<%= JSON.stringify(tags) %>" data-url="<%= url_for(entry.path) %>" <%- !matchesInitial(entry) ? 'hidden' : '' %>>
            <div class="archive-entry-date"><time datetime="<%= date_xml(entry.date) %>" title="<%= date(entry.date, 'YYYY 年 M 月 D 日') %>"><span class="sr-only"><%= date(entry.date, 'YYYY 年 M 月 D 日') %></span><span class="archive-date-visual" aria-hidden="true"><span class="archive-entry-year" data-archive-date-year hidden><%= year %></span><span class="archive-entry-day"><%= date(entry.date, 'MM.DD') %></span></span></time><small><%= kind.label %></small></div>
            <div class="archive-entry-content"><h3><a href="<%= url_for(entry.path) %>"><%= entry.title %></a></h3><p class="archive-entry-summary"><%= summary %></p><div class="archive-entry-meta"><span>约 <%= n_minutes(entry) %> 分钟</span><% tags.slice(0, 2).forEach(tag => { %><span class="archive-entry-tag"><%= tag %></span><% }); %><span class="archive-reading-progress" data-archive-progress hidden></span></div></div>
            <button type="button" class="archive-save" data-archive-save aria-pressed="false" aria-label="收藏《<%= n_plain(entry.title) %>》" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h11v17L12 17l-5.5 3.5z"/></svg></button>
          </article>
          <% }); %>
        </div></section>
        <% }); %>
      </div>
      <div class="archive-empty" data-archive-empty hidden><span aria-hidden="true">∅</span><h2 data-archive-empty-title>没有找到这样的文字</h2><p data-archive-empty-copy>试试更短的关键词，或移除一个筛选条件。</p><button type="button" data-archive-empty-reset>回到全部文字</button></div>
    </div>
  </div>
</div>
