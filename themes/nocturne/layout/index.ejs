<% if (page.current > 1) { %>
<div class="shell collection"><header class="collection-heading"><p class="small-note">沿着时间，继续向前</p><h1>所有文字</h1></header><%- partial('partial/post-list', { entries: page.posts }) %><%- partial('partial/pagination') %></div>
<% } else { const stats = n_stats(); const poem=n_post('Route-Six.md'), cat=n_post('日光之下，有一只白猫.md'), math=n_post('integral-quantaloids-weak-tabularity-topos.md'); %>
<%- partial('partial/string-hero') %>
<section class="home-interlude shell" id="journal" aria-label="我的文字">
  <p class="home-interlude-note">有时埋首纸间，有时流连街头。</p>
  <a class="home-interlude-link" href="<%= url_for('/about/') %>">关于我 <span aria-hidden="true">↗</span></a>
</section>
<section class="home-works shell" aria-labelledby="selected-title">
  <header class="home-works-heading"><h2 id="selected-title">几种抵达世界的方式</h2><p>一首诗，一次停留，一个问题。</p></header>
  <div class="home-works-grid">
    <% if(poem) { %><a class="work work-poem" href="<%= url_for(poem.path) %>">
      <img src="<%= url_for('/nocturne/images/city.webp') %>" alt="杭州的城市天际线" width="1200" height="800" loading="lazy" decoding="async">
      <div class="work-caption"><span>诗与声音</span><span><%= date(poem.date,'YYYY.MM.DD') %></span></div>
      <div class="work-verse" lang="en">No one here knows<br>what I’m proving.</div>
      <div><h3 lang="en">Route Six</h3><p>把夜色，坐过几站。</p></div><span class="work-arrow" aria-hidden="true">↗</span>
    </a><% } %>
    <% if(cat) { %><a class="work work-cat" href="<%= url_for(cat.path) %>">
      <img src="<%= url_for('/nocturne/images/cat.webp') %>" alt="日光下的一只白猫" width="800" height="1067" loading="lazy" decoding="async">
      <div class="work-caption"><span>人间漫游</span><span><%= n_minutes(cat) %> 分钟</span></div>
      <div><h3>日光之下，有一只白猫</h3><p>片刻安闲，胜过许多谋算。</p></div>
    </a><% } %>
    <% if(math) { %><a class="work work-math" href="<%= url_for(math.path) %>">
      <div class="work-caption"><span>数学手记</span><span><%= n_minutes(math) %> 分钟</span></div>
      <span class="work-math-symbol" aria-hidden="true">Q-Set</span>
      <div><h3>何时成为 topos？</h3><p>Integral quantaloid 的 weak tabularity 与 topos</p></div>
    </a><% } %>
  </div>
</section>
<% const paths=[
  {title:'从一座城，走进一个人',description:'先读一次旅行，再读那些舍不得离开的片刻。',sources:['上海、杭州游记.md','做一首世俗的诗.md','再到江安.md']},
  {title:'顺着结构，继续追问',description:'从 co/end 的运算，走向 Q-valued sets 与 topos。',sources:['CoEnd Calculus.md','integral-quantaloids-weak-tabularity-topos.md','bounded-q-valued-sets-cartesian-closedness-topos.md']},
  {title:'让文字，成为声音',description:'一首诗、一次共同写作，然后把它唱出来。',sources:['Route-Six.md','noema-introduction.md','route-six-song.md']}
]; %>
<section class="home-paths shell" aria-labelledby="paths-title">
  <header class="home-paths-heading"><h2 id="paths-title">沿一条线读下去</h2><p>从任何一篇开始，都可以。</p></header>
  <div class="reading-paths"><% paths.forEach(route=>{ const posts=route.sources.map(source=>n_post(source)).filter(Boolean); if(!posts.length)return; %>
    <section class="reading-path"><h3><%= route.title %></h3><p><%= route.description %></p><ol>
      <% posts.forEach(post=>{ %><li><a href="<%= url_for(post.path) %>"><span><%= post.title %></span><small><%= n_minutes(post) %> 分钟</small></a></li><% }); %>
    </ol></section>
  <% }); %></div>
</section>
<section class="journal shell" aria-labelledby="journal-title"><div class="section-heading"><h2 id="journal-title">最近写下的</h2><a class="text-link" href="<%= url_for('/archives/') %>">全部 <%= stats.posts %> 篇 <span aria-hidden="true">↗</span></a></div><%- partial('partial/post-list', { entries: page.posts.limit(6) }) %><a class="journal-more" href="<%= url_for('/archives/') %>">打开完整档案 <span aria-hidden="true">↗</span></a></section>
<%- partial('partial/atlas', { standalone: false }) %>
<% } %>
