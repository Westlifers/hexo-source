<% if (page.current > 1) { %>
<div class="shell collection"><header class="collection-heading"><p class="small-note">沿着时间，继续向前</p><h1>所有文字</h1></header><%- partial('partial/post-list', { entries: page.posts }) %><%- partial('partial/pagination') %></div>
<% } else { const stats = n_stats(); %>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="sculpture" aria-hidden="true"><img class="sculpture-fallback" src="<%= url_for('/nocturne/ribbon.svg') %>" alt=""><canvas data-observatory></canvas></div>
  <div class="hero-orbit" aria-hidden="true"><span>∞</span></div>
  <div class="hero-content shell"><div class="hero-intro"><span class="live-dot"></span><span>杨荻的私人宇宙</span><span class="hero-year">始于 <%= stats.firstYear %></span></div><h1 id="hero-title"><% theme.home.title_lines.forEach((line,i)=>{ %><% if(i) { %><br><% } %><%= line %><% }); %></h1><p class="hero-description"><%= theme.home.introduction %></p><a class="hero-link" href="#journal"><span>进入我的世界</span><span class="round-arrow" aria-hidden="true">↘</span></a></div>
  <div class="art-caption"><span class="caption-line"></span><div>Möbius, a study of infinity<small>一条曲面，没有内外。</small></div></div>
  <div class="hero-bottom shell"><span class="hero-edition">Nocturne <i> / </i> 夜曲</span><button data-motion-toggle aria-pressed="false">暂停流动</button><a href="#journal" class="scroll-cue">向下探索 <span aria-hidden="true">↓</span></a></div>
</section>
<section class="manifesto shell" id="journal"><div class="section-intro"><span class="section-dot"></span><span>理性与浪漫，在这里相遇</span></div><div><h2>有些世界用公理建造。<br>有些世界，靠一盏灯照亮。</h2><p>“像夜晚摩天大楼里，某一层亮着的一盏灯。”</p><a href="<%= url_for(n_post('做一首世俗的诗.md')?.path || '/about/') %>" class="text-link">从《做一首世俗的诗》认识我 <span aria-hidden="true">↗</span></a></div></section>
<section class="selected shell" aria-labelledby="selected-title"><div class="section-heading"><h2 id="selected-title">几种抵达世界的方式</h2><span>选自我的文字</span></div><div class="feature-grid">
<% const poem = n_post('Route-Six.md'); const cat = n_post('日光之下，有一只白猫.md'); const math = n_post('integral-quantaloids-weak-tabularity-topos.md'); %>
<% if (poem) { %><a class="feature feature-poem" href="<%= url_for(poem.path) %>"><img src="<%= url_for('/nocturne/images/city.webp') %>" alt="杭州的城市天际线" loading="lazy" width="1200" height="800"><div class="feature-shade"></div><div class="feature-top"><span>诗与声音</span><span class="circle-link" aria-hidden="true">↗</span></div><div class="feature-poem-lines" lang="en">No one here knows<br>what I’m proving.</div><div class="feature-bottom"><h3>Route Six</h3><p>把夜色，坐过几站。</p><span><%= date(poem.date, 'YYYY.MM.DD') %></span></div></a><% } %>
<% if (cat) { %><a class="feature feature-cat" href="<%= url_for(cat.path) %>"><img src="<%= url_for('/nocturne/images/cat.webp') %>" alt="日光下的一只白猫" loading="lazy" width="800" height="1067"><div class="feature-shade"></div><div class="feature-top"><span>生活切片</span><span class="circle-link" aria-hidden="true">↗</span></div><div class="feature-bottom"><h3>日光之下，<br>有一只白猫</h3><p>片刻安闲，胜过许多谋算。</p></div></a><% } %>
<% if (math) { %><a class="feature feature-math" href="<%= url_for(math.path) %>"><div class="feature-top"><span>数学手记</span><span class="circle-link" aria-hidden="true">↗</span></div><div class="math-art" aria-hidden="true"><svg viewBox="0 0 360 190"><g fill="none"><ellipse cx="180" cy="95" rx="143" ry="56" transform="rotate(-25 180 95)"/><ellipse cx="180" cy="95" rx="143" ry="56" transform="rotate(25 180 95)"/><ellipse cx="180" cy="95" rx="143" ry="56" transform="rotate(90 180 95)"/><path d="M60 95h240M180 20v150"/></g><g><circle cx="180" cy="95" r="4"/><circle cx="50" cy="117" r="3"/><circle cx="308" cy="68" r="3"/></g></svg><span>Sh(Q) ≃ E</span></div><div class="feature-bottom"><h3>抽象之中，<br>自有宇宙。</h3><p>Quantaloid、topos 与结构之间的桥。</p></div></a><% } %>
</div></section>
<section class="journal shell" aria-labelledby="journal-title"><div class="section-heading"><div><p class="small-note">持续发生的思考</p><h2 id="journal-title">最近写下的</h2></div><a class="text-link" href="<%= url_for('/archives/') %>">全部 <%= stats.posts %> 篇 <span aria-hidden="true">↗</span></a></div><%- partial('partial/post-list', { entries: page.posts.limit(6) }) %><a class="journal-more" href="<%= url_for('/archives/') %>">打开完整档案 <span aria-hidden="true">↗</span></a></section>
<section class="atlas-section" id="atlas" data-atlas data-index="<%= url_for('/nocturne/search.json') %>"><div class="shell"><div class="section-heading"><div><p class="small-note">每一个念头，都有自己的引力</p><h2>思想的星图</h2></div><p class="atlas-description">沿着共同的主题，<br>发现文字之间的联系。</p></div><div class="filter-bar" role="group" aria-label="筛选星图"><button data-atlas-filter="all" aria-pressed="true">整个宇宙</button><button data-atlas-filter="mathematics" aria-pressed="false">数学</button><button data-atlas-filter="essays" aria-pressed="false">随笔</button><button data-atlas-filter="poetry" aria-pressed="false">诗与声音</button><button data-atlas-filter="fieldnotes" aria-pressed="false">生活切片</button></div><div class="atlas-stage"></div><p data-atlas-status role="status">正在绘制星图…</p><noscript><a href="<%= url_for('/archives/') %>">按时间浏览全部文章</a></noscript></div></section>
<section class="listening shell"><div class="record" aria-hidden="true"><div><span>Route<br>Six</span></div></div><div class="listening-copy"><p class="small-note">给夜行的人，一段声音</p><h2>再坐几站吧。</h2><p>一首诗，一次 AI 辅助音乐实验。<br>把证明留在纸上，把自己交给夜色。</p><% const song=n_post('route-six-song.md'); %><% if(song) { %><a class="text-link" href="<%= url_for(song.path) %>">歌词与创作说明 ↗</a><% } %></div><div class="listening-control"><button class="play-button" data-audio-toggle aria-label="播放 Route Six" aria-pressed="false"><span data-play-icon>▶</span></button><span data-audio-label>听听 Route Six</span><audio data-home-audio preload="none" src="<%= url_for('/audio/route-six-matikane-tannhauser-v2-softer.mp3') %>"></audio><p data-audio-status role="status"></p></div></section>
<% } %>
