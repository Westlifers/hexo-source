<div class="post-list"><% entries.each(entry => { const kind=n_kind(entry); %><a class="post-row" href="<%= url_for(entry.path) %>"><time datetime="<%= date_xml(entry.date) %>"><span><%= date(entry.date,'MM.DD') %></span><small><%= date(entry.date,'YYYY') %></small></time><div><span class="post-kind"><%= kind.label %></span><h3><%= entry.title %></h3><p><%= n_summary(entry, 95) %></p></div><span class="row-minutes"><%= n_minutes(entry) %> 分钟</span><span class="row-arrow" aria-hidden="true">↗</span></a><% }); %></div>
