<% const content=n_reading_content(entry.content); const outline=toc(content,{max_depth:3,list_number:false}); const ai=n_ai(entry); const kind=n_kind(entry); %>
<div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
<div class="reading-page shell" data-reading-page data-title="<%= entry.title %>"><header class="post-header"><a class="back-link" href="<%= url_for('/archives/') %>">← 回到文字之中</a><div class="post-header-kind"><span class="section-dot"></span><%= isPost ? kind.label : '关于我' %></div><h1><%= entry.title %></h1><div class="post-meta"><time datetime="<%= date_xml(entry.date) %>"><%= date(entry.date,'YYYY 年 M 月 D 日') %></time><span><%= theme.brand.author %></span><span>约 <%= n_minutes(entry) %> 分钟</span></div><% if(ai) { %><details class="ai-disclosure ai-disclosure--<%= ai.level %>"><summary><%= ai.icon %> <%= ai.label %><span>查看说明</span></summary><div><%- ai.note %></div></details><% } %></header>
<div class="reading-grid"><aside class="article-sidebar"><div class="reading-actions"><button data-focus aria-pressed="false">专注阅读</button><button data-save aria-pressed="false">收藏本文</button><button data-copy-link>复制链接</button><button data-font-size aria-label="调整正文字号">字号 A+</button></div><% if(outline) { %><details class="article-outline" open><summary>本篇目录</summary><nav aria-label="本文目录"><%- outline %></nav></details><% } %><div class="reading-position"><span data-reading-percent>0%</span><span>已读</span></div></aside><div class="article-column"><button class="resume-reading" data-resume hidden>继续上次的阅读位置</button><article class="article"><div class="content post-content" data-article-content><%- content %></div></article><div class="post-end"><span class="end-symbol" aria-hidden="true">✳</span><p>感谢你，把一段时间留在这里。</p><div class="post-tags"><% entry.tags?.each(tag=>{ %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div></div>
<% if(isPost) { %><nav class="post-navigation" aria-label="相邻文章"><% if(entry.prev) { %><a href="<%= url_for(entry.prev.path) %>"><span>较新的文字</span><strong><%= entry.prev.title %></strong></a><% } %><% if(entry.next) { %><a href="<%= url_for(entry.next.path) %>"><span>再往过去走一点</span><strong><%= entry.next.title %></strong></a><% } %></nav><% if(theme.comments.enable && entry.comments !== false) { %><%- partial('partial/comments') %><% } %><% } %></div></div></div>
