<% const scene = n_string_home(); const stringIntro = theme.home && theme.home.introduction; %>
<section class="string-hero" aria-labelledby="string-hero-title" data-string-hero data-source="<%= url_for(config.nocturne_preview ? '/nocturne/strings/runtime.json' : '/nocturne/strings/scenes/' + scene.candidate.id + '.json') %>" data-candidate="<%= scene.candidate.id %>" data-string-root="<%= url_for('/nocturne/strings/') %>">
  <div class="string-hero-atmosphere" aria-hidden="true"></div>
  <div class="string-hero-intro shell">
    <div class="string-identity">
      <p class="string-owner"><span aria-hidden="true"></span>杨荻的私人宇宙</p>
      <h1 id="string-hero-title"><% (theme.home.title_lines || ['在无穷中，', '留一盏灯。']).forEach((line,index)=>{ %><% if (index) { %><br><% } %><%= line %><% }); %></h1>
    </div>
    <div class="string-verse">
      <p class="string-sentence" lang="en" data-string-sentence><%= scene.candidate.sentence %></p>
      <p class="string-translation" data-string-translation><%= scene.candidate.translation %></p>
    </div>
  </div>

  <figure class="string-score shell" aria-label="这句话的一种 DisCoCat 分析">
    <div class="string-score-window" data-string-scroll tabindex="0" role="region" aria-label="句子的弦图，小屏幕可左右滚动查看">
      <div class="string-stage" data-string-stage><%- scene.svg %></div>
    </div>
    <div class="string-view-tools"><p class="string-scroll-note"><span aria-hidden="true">↔</span> 左右滑动，沿着线条读下去</p><button class="string-scale" type="button" data-string-scale aria-pressed="false" disabled>放大读图</button></div>
    <figcaption class="string-score-footer">
      <details class="string-colophon">
        <summary><span class="string-edition" lang="en">Nocturne <i>/</i> <span lang="zh-CN">夜曲</span></span><span class="string-colophon-prompt">关于这幅图 <span class="string-disclosure-mark" aria-hidden="true">+</span></span></summary>
        <div class="string-colophon-content">
          <p>这句话的一种 DisCoCat 分析。词语在这里有了形状，连接呈现它们组合成句子的关系。</p>
          <a href="<%= url_for('/' + scene.candidate.rawSvg) %>" data-string-original target="_blank" rel="noopener">查看原始弦图 <span aria-hidden="true">↗</span></a>
        </div>
      </details>
      <div class="string-controls" role="group" aria-label="弦图显示选项">
        <button type="button" data-string-detail aria-pressed="false" disabled><span aria-hidden="true">α</span><span data-control-label>展开类型</span></button>
        <button type="button" data-string-motion aria-pressed="false" disabled><span class="string-motion-symbol" aria-hidden="true"><i></i><i></i></span><span data-control-label>暂停流动</span></button>
      </div>
    </figcaption>
  </figure>

  <div class="string-hero-bottom shell">
    <% if (stringIntro) { %><p><%= stringIntro %></p><% } %>
    <a href="#journal" class="string-enter">走进我的文字 <span aria-hidden="true">↓</span></a>
  </div>

  <% if (config.nocturne_preview) { %>
  <details class="string-review shell">
    <summary><span>试映中的句子</span><span class="string-review-hint">切换另一个夜晚 <span class="string-disclosure-mark" aria-hidden="true">+</span></span></summary>
    <div class="string-review-content">
      <label for="string-candidate">选择句子</label>
      <select id="string-candidate" data-string-candidate disabled>
        <% scene.candidates.forEach(candidate=>{ %><option value="<%= candidate.id %>"<%- candidate.id === scene.candidate.id ? ' selected' : '' %>><%= candidate.id %> · <%= candidate.title || candidate.sentence %></option><% }); %>
      </select>
      <p>九个句子，看看它们在首页的样子。</p>
    </div>
  </details>
  <% } %>
  <noscript><style>.string-hero .string-controls,.string-hero .string-review{display:none}</style><p class="string-nojs shell">你正在看静态弦图。句子与原始图纸仍可完整阅读。</p></noscript>
</section>
